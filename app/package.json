{
  "name": "keystone-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keystone hub client: protocol library, mock hub and (later) the Expo app. See ../docs/app-protocol.md",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mock-hub": "tsx tools/mock-hub/main.ts",
    "probe": "tsx tools/probe.ts",
    "hub-check": "tsx tools/hub-check.ts",
    "discover": "tsx tools/discover.ts",
    "start": "expo start",
    "web": "expo start --web",
    "export:web": "expo export --platform web"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "~19.2.4",
    "@types/ws": "8.18.2",
    "jsdom": "30.1.2",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "expo": "57.0.27",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.4"
  },
  "main": "index.ts"
}
