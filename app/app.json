{
  "expo": {
    "name": "Keystone",
    "slug": "keystone",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "keystone",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kliuchnikovv.keystone",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Keystone talks to your hub on your home network.",
        "NSBluetoothWhileInUseUsageDescription": "Keystone looks for the devices around you when you add one, so it can tell you which device is next to you.",
        "NSBonjourServices": [
          "_keystone._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "LSApplicationQueriesSchemes": ["x-apple-com-home"],
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).AppDelegate"
              }
            ]
          }
        }
      },
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.keystone.app",
      "permissions": [
        "android.permission.CHANGE_WIFI_MULTICAST_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#185cd6"
      },
      "versionCode": 1
    },
    "icon": "./assets/icon.png",
    "plugins": [
      "./plugins/withSceneLifecycle.cjs",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Keystone uses your approximate position only to tell the hub where it is, so that sunrise and sunset are right."
        }
      ]
    ]
  }
}
