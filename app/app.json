{
  "expo": {
    "name": "Keystone",
    "slug": "keystone",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "keystone",
    "web": { "bundler": "metro", "output": "single" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.keystone.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Keystone talks to your hub on your home network.",
        "NSBonjourServices": ["_keystone._tcp"],
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true }
      }
    },
    "android": {
      "package": "dev.keystone.app",
      "permissions": ["android.permission.CHANGE_WIFI_MULTICAST_STATE"]
    }
  }
}
