{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keystone.io/schemas/plugin-manifest/v1.json",
  "title": "Keystone plugin manifest v1",
  "description": "Normative schema for plugin.yaml. See docs/plugin-store-architecture.md §3.1.",
  "$comment": "Structural rules only. Cross-field rules (entrypoint-or-ui, unique sidecar names, embedded config schema validity, path traversal) live in internal/plugin/semantic.go so they can report a precise yaml line.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "keystone.plugin/v1"
    },
    "kind": {
      "const": "Plugin"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    },
    "ui": {
      "type": "object",
      "$comment": "Owned by the [UI] tickets (Layer 1-4). Accepted as-is until docs/plugin-ui-integration.md is formalised."
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "displayName", "version", "description", "maintainer", "license", "category", "trustTier"],
      "properties": {
        "name": {
          "description": "Unique registry slug.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "description": "SemVer 2.0.0.",
          "$ref": "#/$defs/semver"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "maintainer": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "description": "SPDX identifier.",
          "type": "string",
          "minLength": 1
        },
        "homepage": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "category": {
          "enum": ["transport", "device", "automation", "ai", "ui", "utility"]
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "trustTier": {
          "enum": ["core", "verified", "experimental", "unsafe"]
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keystoneCoreMin", "capabilities"],
      "properties": {
        "keystoneCoreMin": {
          "$ref": "#/$defs/semver"
        },
        "keystoneCoreMax": {
          "description": "Upper compatibility bound. Accepts a full SemVer or a wildcard such as 1.x / 1.2.x.",
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.((0|[1-9][0-9]*)\\.((0|[1-9][0-9]*)|x)|x)$"
        },
        "capabilities": {
          "description": "Dotted capability ids, identical to the sidecar v1 hello handshake. See docs/sidecar-protocol-v1.md.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        },
        "dependsOn": {
          "description": "Slugs of plugins that must be installed and running first.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$"
          }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/permission"
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "entrypoint": {
          "$ref": "#/$defs/entrypoint"
        },
        "sidecars": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sidecar"
          }
        },
        "config": {
          "$ref": "#/$defs/config"
        }
      }
    },
    "permission": {
      "description": "Either a bare permission id (network.lan) or a single-key mapping carrying its scopes (secretstore.read: [matter.fabric-key]).",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$"
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory": {
          "$ref": "#/$defs/quantity"
        },
        "disk": {
          "$ref": "#/$defs/quantity"
        },
        "cpu": {
          "description": "Millicores (100m) or whole/fractional cores (0.5, 2).",
          "type": "string",
          "pattern": "^([1-9][0-9]*m|[0-9]+(\\.[0-9]+)?)$"
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exec"],
      "properties": {
        "exec": {
          "$ref": "#/$defs/relPath"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "$ref": "#/$defs/env"
        }
      }
    },
    "sidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "exec", "runtime"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,38}[a-z0-9]$"
        },
        "exec": {
          "$ref": "#/$defs/relPath"
        },
        "runtime": {
          "enum": ["native", "node20", "node22", "python311", "python312"]
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "$ref": "#/$defs/env"
        },
        "restart": {
          "enum": ["always", "on-failure", "never"],
          "default": "on-failure"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": {
        "schema": {
          "description": "JSON Schema (draft-07 or 2020-12) for user-facing settings, embedded as a string.",
          "type": "string",
          "minLength": 2
        }
      }
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "relPath": {
      "description": "Path relative to the plugin directory.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_./-]*$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti|K|M|G|T)?$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*))?(\\+([0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*))?$"
    }
  }
}
