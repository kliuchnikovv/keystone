# Keystone relay — deployment environment for keystone-relay.service
#
#   sudo install -m 600 /dev/null /etc/keystone-relay.env
#   sudo sh -c 'printf "SECRET=%s\nPORT=9090\n" "$(openssl rand -hex 32)" > /etc/keystone-relay.env'
#
# The same secret goes into the hub's NVS with the console command
#   relay wss://relay.example.com/hub/<hub-id> <secret>
# and it is NOT the app protocol token: it only lets a hub attach to its own tunnel.
# Rotate it with `relay <url> <new-secret>` on the hub (or `relay clear` first).

SECRET=replace-with-output-of-openssl-rand-hex-32
PORT=9090