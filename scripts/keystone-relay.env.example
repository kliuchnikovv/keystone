# Keystone relay — deployment environment for keystone-relay.service
#
#   sudo install -m 600 /dev/null /etc/keystone-relay.env
#   sudo sh -c 'printf "RELAY_SECRET=%s\nPORT=9090\n" "$(openssl rand -hex 32)" > /etc/keystone-relay.env'
#
# The same secret goes into the hub's NVS with the console command
#   relay wss://relay.example.com/tunnel/<hub-id> <secret>
# and it is NOT the app protocol token: it only lets a hub attach to its own tunnel.
# Rotate it with `relay <url> <new-secret>` on the hub (or `relay clear` first).
#
# RELAY_MASTER_SECRET is the better way to run a relay that serves more than one
# home: the relay then derives the secret of every hub from it (HMAC-SHA256 of
# "hub:<id>"), so a new home is a flash of the box and nothing on the server.
#   sudo sh -c 'printf "RELAY_MASTER_SECRET=%s\nPORT=9090\n" "$(openssl rand -hex 32)" > /etc/keystone-relay.env'
# and the box is flashed with scripts/gen-hub-relay.sh, which derives the same value.

RELAY_SECRET=replace-with-output-of-openssl-rand-hex-32
PORT=9090
