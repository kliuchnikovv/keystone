// keystone-plugin-{{.Name}} — replace this description with what your
// plugin does. Everything below is scaffolding; the two things you own
// are the adapter (implements ports.Adapter) and, optionally, an
// ErrorMapper that translates your errors into sidecar codes.
package main

import (
	"context"
	"log/slog"
	"os"

	"github.com/kliuchnikovv/keystone/plugins/sdk"

	"{{.Module}}/internal/{{.Name}}"
)

// Version is stamped into hello. Bump on protocol or config changes.
const Version = "0.1.0"

func main() {
	log := slog.New(slog.NewJSONHandler(os.Stderr, &slog.HandlerOptions{Level: slog.LevelInfo}))

	adapter := {{.Name}}.NewAdapter(log)

	err := sdk.Run(context.Background(), sdk.Options{
		Name:         "{{.Name}}",
		Version:      Version,
		Capabilities: []string{"transport.{{.Transport}}"},
		Adapter:      adapter,
		Logger:       log,
	})
	if err != nil {
		log.Error("plugin exited", "err", err)
		os.Exit(1)
	}
}
