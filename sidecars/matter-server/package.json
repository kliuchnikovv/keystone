{
  "name": "keystone-matter-server",
  "version": "0.1.0",
  "private": true,
  "description": "matter.js sidecar for the keystone smart-home engine. Exposes a small JSON-RPC surface over WebSocket to the Go core.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "tsc -w -p . & node --watch dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@matter/main": "^0.15.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.0"
  }
}
