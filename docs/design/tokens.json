{
  "$comment": "Keystone client design tokens. Source of truth for the shipped app is app/src/ui/theme.ts; this file mirrors it for designers and tooling. Keep the two in sync.",
  "meta": {
    "name": "Keystone",
    "version": "1.0.0",
    "updated": "2026-10-26",
    "platforms": ["ios", "android", "web"],
    "idiom": "Warm sandstone paper, ink text, one terracotta accent (ember) that only ever means affordance or live heat."
  },

  "color": {
    "light": {
      "bg": "#f5f1e8",
      "card": "#ffffff",
      "surface": "#ffffff",
      "glass": "rgba(255,255,255,0.70)",
      "glassBorder": "rgba(255,255,255,0.70)",
      "glassSheen": "rgba(255,255,255,0.95)",
      "text": "#15171c",
      "muted": "#6f6a5c",
      "border": "#e3ddcd",
      "accent": "#c4512a",
      "accentSoft": "rgba(196,81,42,0.12)",
      "fill": "rgba(0,0,0,0.06)",
      "cool": "#2f6fb8",
      "onAccent": "#ffffff",
      "good": "#2f7a4d",
      "warn": "#a8760f",
      "bad": "#b53b3b"
    },
    "dark": {
      "bg": "#14161b",
      "card": "#1d2027",
      "surface": "#1d2027",
      "glass": "rgba(40,44,54,0.72)",
      "glassBorder": "rgba(255,255,255,0.10)",
      "glassSheen": "rgba(255,255,255,0.18)",
      "text": "#f3efe7",
      "muted": "#9a9384",
      "border": "#2c303a",
      "accent": "#e07a4a",
      "accentSoft": "rgba(224,122,74,0.18)",
      "fill": "rgba(255,255,255,0.08)",
      "cool": "#5aa2e8",
      "onAccent": "#14161b",
      "good": "#4fbe7f",
      "warn": "#e0a63c",
      "bad": "#ef6b6b"
    },
    "ember": {
      "$comment": "The second palette: dark glass and amber. Dark only — the system light/dark does not change it.",
      "bg": "#0d0602",
      "card": "rgba(255,255,255,0.07)",
      "surface": "#171009",
      "glass": "rgba(255,255,255,0.058)",
      "glassBorder": "rgba(255,182,92,0.12)",
      "glassSheen": "rgba(255,238,148,0.12)",
      "text": "#fffcf5",
      "muted": "rgba(255,205,128,0.62)",
      "border": "rgba(255,182,92,0.14)",
      "accent": "#FF9F0A",
      "accentSoft": "rgba(255,152,32,0.26)",
      "fill": "rgba(255,255,255,0.06)",
      "cool": "#64b4ff",
      "onAccent": "#1a0b00",
      "good": "#78f096",
      "warn": "#ffc048",
      "bad": "#ff6e5a"
    }
  },

  "palette": {
    "$comment": "The palette is a setting of the phone, not of the hub. Picked in the app: Hub → Appearance.",
    "default": "sandstone",
    "options": [
      { "id": "sandstone", "name": "Sandstone", "hint": "Warm paper, terracotta accent", "followsSystem": true },
      { "id": "ember", "name": "Ember", "hint": "Dark glass, amber accent", "followsSystem": false }
    ]
  },

  "radius": {
    "$comment": "card follows the palette: 18 in sandstone, 22 in ember (Theme.cardRadius).",
    "card": 18,
    "chip": 11,
    "pill": 999,
    "field": 12
  },

  "space": {
    "xs": 6,
    "sm": 10,
    "md": 14,
    "lg": 20,
    "xl": 28
  },

  "type": {
    "$comment": "System font (SF Pro / Roboto / Segoe). Sizes in pt, weights 400/500/600/700.",
    "display": { "size": 30, "weight": 700, "tracking": -0.02, "usage": "greeting title, screen h1" },
    "title": { "size": 22, "weight": 700, "usage": "the hub's name on the Devices screen" },
    "screenTitle": { "size": 17, "weight": 700, "tracking": -0.3, "usage": "the title in the top bar (Automations, Hub, History)" },
    "cardTitle": { "size": 17, "weight": 600, "usage": "hub card headings" },
    "deviceName": { "size": 14, "weight": 700, "usage": "the name under a device's icon in the grid" },
    "body": { "size": 15, "weight": 400, "usage": "paragraphs, list values" },
    "label": { "size": 13, "weight": 500, "usage": "field labels, secondary text" },
    "caption": { "size": 12, "weight": 500, "usage": "hints, timestamps" },
    "overline": { "size": 12, "weight": 700, "tracking": 0.8, "transform": "uppercase", "usage": "room headers, section labels" },
    "reading": { "size": 34, "weight": 700, "tracking": -0.02, "usage": "sensor big number" },
    "mono": { "family": "Menlo / monospace", "size": 13, "usage": "tokens, fingerprints, codes" }
  },

  "material": {
    "glassCard": {
      "background": "color.glass",
      "border": "1px solid color.glassBorder",
      "radius": "radius.card",
      "backdrop": "blur(14px) saturate(180%)",
      "sheen": "inset 0 1px 0 color.glassSheen",
      "shadow": "0 8px 24px rgba(0,0,0,0.10)"
    },
    "solidCard": {
      "background": "color.card",
      "border": "1px solid color.border",
      "radius": "radius.card",
      "shadow": "none"
    },
    "tabBar": {
      "$comment": "iOS keeps the floating pill (h 60, inset 16, width 100%-32, glyph 21); Android and the web use the room mock's full-width panel: 62 px of tabs plus 20 px for the home indicator, glyph 22.",
      "background": "color.tabBar",
      "borderTop": "1px solid color.border",
      "height": 82,
      "paddingTop": 10,
      "paddingBottom": 20,
      "glyph": 22,
      "label": 10
    },
    "banner": { "paddingVertical": 8, "paddingHorizontal": 14, "radius": 0, "textAlign": "center" },
    "sheet": { "radius": 24, "padding": "18 20 36", "maxHeight": "78%", "backdrop": "blur(28px) saturate(180%)" },
    "toast": { "radius": 14, "padding": 14, "inset": "16px 16px 88px", "background": "color.text", "text": "color.bg" }
  },

  "icon": {
    "grid": 24,
    "stroke": 2,
    "cap": "round",
    "join": "round",
    "fill": "none",
    "filledOpacity": 0.22,
    "rule": "one 24x24 grid, 2 px stroke, round caps; the filled variant fills the main shape at 22 % to read as 'on'.",
    "sizes": { "tab": 21, "card": 19, "inline": 15, "sheet": 24 },
    "names": [
      "light", "switch", "sensor", "occupancy", "contact", "cover", "lock", "climate", "button",
      "home", "automation", "hub", "history", "plus", "pencil", "chevron", "play", "check",
      "bolt", "chip", "signal", "more", "eye", "eye-off"
    ]
  },

  "motion": {
    "rule": "Transitions are short and functional only; nothing bounces. The app itself ships no animation library.",
    "duration": { "fast": 150, "base": 220, "slow": 320 },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "decelerate": "cubic-bezier(0, 0, 0, 1)" },
    "confirmDeleteTimeoutMs": 3000
  },

  "units": {
    "temperature": "°C",
    "brightness": "%",
    "battery": "%",
    "power": "W",
    "energy": "kWh",
    "illuminance": "lx",
    "clock": "24h"
  }
}
