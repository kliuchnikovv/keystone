CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# The C6's USB connector is the USB-Serial-JTAG peripheral. Keep the console
# (and with it the log output and our REPL) there: it is the same cable we
# flash with, while the UART0 pins of the DevKitC are not wired to it.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Use a custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
# esp-idf 5.5 uses CUSTOM_FILENAME.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# The Thread network we lend to the brain. The keys are left empty on purpose:
# the network key and the PSKc are generated on the first boot and kept in NVS,
# never written down in the source.
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_OPENTHREAD_RADIO_NATIVE=y
CONFIG_OPENTHREAD_NETWORK_CHANNEL=15
CONFIG_OPENTHREAD_NETWORK_NAME="keystone-home"
CONFIG_OPENTHREAD_MESH_LOCAL_PREFIX="fd00::/64"
CONFIG_OPENTHREAD_NETWORK_MASTERKEY=""
CONFIG_OPENTHREAD_NETWORK_PSKC=""

# --- keystone overrides ---
# Main task headroom for the UART bridge and the OpenThread start-up.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# Brownout detector OFF (not just a lower threshold). The C6-DevKitC on USB dips
# its 3.3 V rail during Thread/radio bursts; even level 1 (~2.58 V) tripped and the
# chip reset with E BOD: Brownout detector was triggered. main.cpp also disables
# the ana BOD at runtime. Cost: a collapsing supply hangs the chip instead of
# rebooting it.
# CONFIG_ESP_BROWNOUT_DET is not set

# Border Router: SRP server + DNS-SD server + border routing are turned on by
# the one BORDER_ROUTER flag below. Wi-Fi is the infrastructure (backbone)
# netif; mDNS reflects Thread services onto it.
CONFIG_OPENTHREAD_BORDER_ROUTER=y
