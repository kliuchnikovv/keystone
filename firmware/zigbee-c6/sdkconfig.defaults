# Native ESP-IDF build defaults for the Zigbee coordinator (ESP32-C6).
# idf.py generates sdkconfig from this; do not hand-edit the generated sdkconfig.

# --- Zigbee stack: coordinator/router role on the on-chip 802.15.4 radio ---
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZCZR=y
CONFIG_ZB_RADIO_NATIVE=y

# --- Partition table (zb_storage/zb_fct live here) ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- 4 MB flash (this C6 board), matches the PlatformIO build ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- Zigbee stack expects a 1 kHz tick ---
CONFIG_FREERTOS_HZ=1000

# Brownout detector OFF (not just a lower threshold). The C6-DevKitC on USB dips
# its 3.3 V rail during a Zigbee transmission; even level 1 (~2.58 V) tripped and
# the chip brownout-reset every ~40 s under load (E BOD: Brownout detector was
# triggered, rst:0x3). main.cpp additionally disables the ana BOD at runtime.
# Cost: a genuinely collapsing supply now hangs the chip instead of rebooting it.
# CONFIG_ESP_BROWNOUT_DET is not set

# --- OTA from the brain over the UART link (docs/ota.md) ---
# A new image boots "pending verify" and is reverted by the bootloader on the next
# reset unless the app confirms itself (we do, once the brain has queried us).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_ROLLBACK_ENABLE=y
