# experiment/commissioner-on-s3: Matter controller/commissioner overlay for
# brain-s3. Picked up only when scripts/matter-build.sh builds this app (it
# sets SDKCONFIG_DEFAULTS to include this file alongside sdkconfig.defaults).
# PlatformIO does not read it, so the normal brain build is unaffected.
#
# Values copied from esp-matter examples/controller/sdkconfig.defaults +
# sdkconfig.defaults.esp32s3 (release/v1.6). Only the settings that touch
# what already is in the brain are commented inline; the rest mirror the
# vendor's example byte-for-byte.

# --- Code size ---
# The Matter controller + the brain do not fit the 1.875 MB app partition at
# the IDF default (-Og): the image was 0x1e0650 — 1616 B over. -Os (the
# vendor's own release setting) buys back well over 100 KB and keeps the
# normal (non-Matter) PlatformIO build untouched, because PlatformIO does not
# read this overlay.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- Matter controller/commissioner feature flags ---
CONFIG_ENABLE_CHIP_CONTROLLER_BUILD=y
CONFIG_ESP_MATTER_CONTROLLER_ENABLE=y
CONFIG_ESP_MATTER_COMMISSIONER_ENABLE=y
# The brain is a controller, not a device: no Matter server role.
CONFIG_ESP_MATTER_ENABLE_MATTER_SERVER=n

# BLE for commissioning (S3-only, docs/matter-backlog.md §3).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_ENABLE_ESP32_BLE_CONTROLLER=y
# BLE stays enabled after commissioning so the controller can re-pair a device.
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n

# Slim the BLE controller: the hub is a Matter COMMISSIONER, not an accessory.
# It only ever talks to one device at a time (a single commissioning session).
# Dropping max-connections to 1 and the optional 5.x LE features (extended adv,
# periodic adv, privacy, ISO) cuts a few KB off the controller's static+heap
# footprint — without these BLE_INIT cannot find its ~30 KB contiguous
# internal-RAM block on brain-s3's layout.
#
# NB: the NimBLE **role** flags (`BT_NIMBLE_ROLE_PERIPHERAL=n` etc.) look tempting
# but break the link: `ble_gattc.c::ble_gatts_indicate_custom` references
# server-side `ble_att_svr_*` which gets dropped with the peripheral role.
# `--gc-sections` cannot fix this cross-reference. So we leave all roles on and
# only tune the per-connection footprint.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_LE_MAX_CONNECTIONS=1
CONFIG_BT_LE_LL_ISO=n
CONFIG_BT_LE_FEAT_LL_PRIVACY=n
CONFIG_BT_LE_FEAT_LL_EXT_ADV=n
CONFIG_BT_LE_FEAT_LL_PERIODIC_ADV=n
CONFIG_BT_LE_FEAT_LL_PERIODIC_ADV_SYNC=n
CONFIG_BT_LE_ERROR_SIM_ENABLED=n

# Minimum BLE controller buffer counts — the biggest internal-RAM pool on
# brain-s3 after heap_init is only ~31 KB (the pool is split by FreeRTOS task
# stacks laid down before app_main). Default controller counts need ~40 KB one
# shot, which is why `BLE_INIT: Malloc failed` fires. These minimums leave
# just enough for one commissioning session.
CONFIG_BT_LE_ACL_BUF_COUNT=3
CONFIG_BT_LE_HCI_EVT_HI_BUF_COUNT=8
CONFIG_BT_LE_HCI_EVT_LO_BUF_COUNT=4
CONFIG_BT_LE_MSYS_1_BLOCK_COUNT=5
CONFIG_BT_LE_MSYS_2_BLOCK_COUNT=5
CONFIG_BT_LE_LL_RESOLV_LIST_SIZE=1
CONFIG_BT_LE_WHITELIST_SIZE=1

# Matter needs HKDF.
CONFIG_MBEDTLS_HKDF_C=y

# LwIP / IPv6: Matter uses link-local + ULA per fabric. The brain already has
# CONFIG_LWIP_IPV6=y. The address count is one ULA per fabric + a link-local.
# The controller vendor example wrote 12 in the main defaults and then 6 lower
# down — the 6-address override is what actually lands. We stay at 6 (fits 5
# fabrics + 1 LL) so the static BSS of lwip netif stays small.
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
# A controller normally needs more UDP endpoints for CASE sessions, but 8 is
# enough for a single-user hub (one commissioning session + a few open fabrics)
# and halves the UDP PCB BSS vs the vendor's default of 16.
CONFIG_NUM_UDP_ENDPOINTS=8

# CHIP task stack. The brain's own main task stays at 8192 (its own
# sdkconfig.defaults) — the controller example asks for 10240, but on our
# small-internal-RAM S3-Zero that extra 2 KB sits in the middle of the heap
# pool and splits the largest-free block in half, which is why the BLE
# controller cannot find its ~40 KB contiguous allocation.
CONFIG_CHIP_TASK_STACK_SIZE=15360

# Dev DAC — fine for commissioning development, replaced before production
# (see docs/matter-backlog.md §6).
CONFIG_USE_TEST_SETUP_PIN_CODE=20212020
CONFIG_USE_TEST_SETUP_DISCRIMINATOR=0xF0

# --- Attestation trust store ---
# The commissioner verifies the accessory's DAC against the PAA that signed its
# PAI. esp-matter's default store holds only the two hardcoded Chip-Test roots,
# so a real product (the IKEA TIMMERFLOTTE) fails with "Unable to find PAA".
# The proper route is the DCL (download the PAA over HTTPS), but that pulls an
# HTTP client + TLS + cJSON into the image and the app partition has ~7 KB
# left. We ship our own store instead (main/matter_paa.cpp) with the IKEA
# production PAA compiled in — 487 bytes of DER.
CONFIG_CUSTOM_ATTESTATION_TRUST_STORE=y

# The vendor's own path pins this off until verified.
CONFIG_SUPPORT_GROUPCAST_CLUSTER=n

# RAM optimisation: move the Matter library BSS and heap into PSRAM (this is
# exactly the knob the vendor's RAM-optimised S3 config uses, and the reason
# this experiment needed PSRAM enabled first — see 0a04976). The Zero's PSRAM
# is quad, not OCT like the vendor's S3 reference — so we skip the OCT speed
# knob and keep the same contentful ones.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
# CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y was tried but moves mbedtls DRBG state
# into PSRAM; CHIP's crypto layer (GetRandU16 via Assertions.h) then asserts.
# mbedtls stays internal; its DRBG session buffers are small anyway.
# CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC is not set

# Push ALL dynamic allocations under 512 B into PSRAM by default (anything that
# truly needs internal RAM, e.g. DMA buffers, uses heap_caps_malloc explicitly).
# Our base sdkconfig has 16384 for PlatformIO, so every Matter heap call stayed
# in internal — that is what ate 125 KB of internal in esp_matter::start() and
# panicked the brain. 512 is the vendor's own RAM-optimisation value.
# 512 was too aggressive — BLE controller's DMA-adjacent small allocations
# cannot live in PSRAM and the stack aborted inside CHIP init. 2048 keeps the
# tiny (<2 KB) allocations in internal RAM where BLE/Wi-Fi radios need them,
# and pushes everything else (Matter stack, mbedtls session state, DNS-SD) to
# PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
