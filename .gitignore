# Host build (CMake)
/build/
/build-*/
cmake-build-*/

# ESP-IDF per-app build output
firmware/*/build/
firmware/*/build-*/
firmware/*/sdkconfig
firmware/*/sdkconfig.old
firmware/*/sdkconfig.bak
firmware/*/sdkconfig.bod
firmware/*/managed_components/
firmware/*/managed_components_rootowned/
firmware/*/managed_components.stale/
# wasm-plugin-spike: WAMR is vendored into firmware/components/wamr for patching
# (component manager re-downloads managed/ on every reconfigure, losing the
# patches). Not committed — see scripts/wamr-patches.py to re-materialise it.
firmware/components/wamr/
firmware/*/dependencies.lock

# Plugin build output (scripts/build-plugins.sh): the .wasm files are
# artefacts — the copies the firmware links in are regenerated into
# firmware/components/wasm_host/include/wasm_host/*_wasm.hpp.
plugins/build/

# A crash dump read off a co-processor (scripts/flash-thread-c6-matter.sh
# --coredump): a local artefact of one crash, never in git.
firmware/*/coredump.bin
# The NVS partition of a co-processor, read off the chip (--nvs): it holds the
# Thread dataset, the Matter fabric and the device keys.
firmware/*/nvs.bin
# The brain's boot log, captured off the console (--brain-reset): a local
# artefact of one boot, never in git.
firmware/*/boot.log

# Loose build logs captured at the repo root
/build*.log

# Editor / OS
.vscode/
.idea/
.cache/
compile_commands.json
*.o
*.a
.DS_Store

# Local secrets
firmware/*/main/wifi_secrets.h

# PlatformIO build output
.pio/

# Node (app/)
node_modules/
dist/
.expo/

# Secrets. The .env in the root of the repository holds the relay's master key
# and whatever else has to stay out of git.
.env
.env.*

# The hub's relay identity (scripts/gen-hub-relay.sh): the secret the hub uses to
# register with the relay. Never in git.
firmware/*/main/relay_identity.h

# The hub's TLS identity (scripts/gen-hub-cert.sh): never commit the private key.
firmware/*/main/hub_key.pem
firmware/*/main/hub_cert.pem
firmware/*/main/hub_identity.cpp

# Native projects generated by `expo prebuild` (app/); the sources of truth are app.json and modules/
app/ios/
app/android/

# Relay Go binary (built)
/relay/relay
.claude/

# A plugin .wasm left next to its source by a manual build (the build script
# puts its output in plugins/build/).
plugins/*/*.wasm
