# Host build (CMake)
/build/
/build-*/
cmake-build-*/

# ESP-IDF per-app build output
firmware/*/build/
firmware/*/build-*/
firmware/*/sdkconfig
firmware/*/sdkconfig.old
firmware/*/sdkconfig.bak
firmware/*/sdkconfig.bod
firmware/*/managed_components/
firmware/*/dependencies.lock

# Loose build logs captured at the repo root
/build*.log

# Editor / OS
.vscode/
.idea/
.cache/
compile_commands.json
*.o
*.a
.DS_Store

# Local secrets
firmware/*/main/wifi_secrets.h

# PlatformIO build output
.pio/

# Node (app/)
node_modules/
dist/
.expo/

# Secrets. The .env in the root of the repository holds the relay's master key
# and whatever else has to stay out of git.
.env
.env.*

# The hub's relay identity (scripts/gen-hub-relay.sh): the secret the hub uses to
# register with the relay. Never in git.
firmware/*/main/relay_identity.h

# The hub's TLS identity (scripts/gen-hub-cert.sh): never commit the private key.
firmware/*/main/hub_key.pem
firmware/*/main/hub_cert.pem
firmware/*/main/hub_identity.cpp

# Native projects generated by `expo prebuild` (app/); the sources of truth are app.json and modules/
app/ios/
app/android/

# Relay Go binary (built)
/relay/relay
